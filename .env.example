# EmailJS credentials — required for the "Book a demo" form to send you an email.
# 1. Create a free account at https://www.emailjs.com
# 2. Add an Email Service (Gmail, Outlook, etc.) — copy its Service ID below
# 3. Create an Email Template with these variables in the body:
#      {{from_name}} {{from_email}} {{practice}} {{demo_date}} {{demo_time}} {{notes}}
#    Set the template's "To email" to YOUR inbox (e.g. hello@clinicflowai.com)
# 4. Copy the Template ID below
# 5. In EmailJS dashboard > Account > General, copy your Public Key below
#
# Then rename this file to .env and restart `npm run dev`.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ---
# AI chat widget (Flo) — required for the floating chat button to actually reply.
# Get a key at https://console.anthropic.com
# IMPORTANT: this one has NO "VITE_" prefix on purpose — that keeps it server-side only,
# used by api/chat.js, and never bundled into the browser JS. Do not rename it to add VITE_.
ANTHROPIC_API_KEY=your_anthropic_api_key
